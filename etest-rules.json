{
  "name": "全项产测",
  "rules": [
    {
      "id": "cpu-clock",
      "mode": "cpu-clock",
      "metric": "",
      "unit": "MHz",
      "min": null,
      "max": null,
      "max_std": null,
      "secs": 5,
      "load": 0.0
    },
    {
      "id": "cpu-temp",
      "mode": "temp",
      "metric": "CPU Package",
      "unit": "°C",
      "min": null,
      "max": 85.0,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "gpu-temp",
      "mode": "temp",
      "metric": "GPU",
      "unit": "°C",
      "min": null,
      "max": 90.0,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "mobo-temp",
      "mode": "temp",
      "metric": "Mainboard",
      "unit": "°C",
      "min": null,
      "max": 60.0,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "fan",
      "mode": "fan-speed",
      "metric": "",
      "unit": "RPM",
      "min": 500.0,
      "max": null,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "voltage",
      "mode": "voltage",
      "metric": "",
      "unit": "V",
      "min": null,
      "max": null,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "power",
      "mode": "power",
      "metric": "",
      "unit": "W",
      "min": null,
      "max": null,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "cpu-usage",
      "mode": "cpu-usage",
      "metric": "CPU_Usage_Global",
      "unit": "%",
      "min": null,
      "max": 100.0,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "ram-usage",
      "mode": "mem-usage",
      "metric": "RAM_Usage",
      "unit": "%",
      "min": null,
      "max": 90.0,
      "max_std": 2.0,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "disk-c",
      "mode": "disk-usage",
      "metric": "C: Used%",
      "unit": "%",
      "min": null,
      "max": 90.0,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    },
    {
      "id": "net-up",
      "mode": "net-speed",
      "metric": "Total_Rx",
      "unit": "B/s",
      "min": 1000000.0,
      "max": null,
      "max_std": null,
      "secs": 5,
      "load": 0.0
    },
    {
      "id": "gpu-usage",
      "mode": "gpu-usage",
      "metric": "",
      "unit": "%",
      "min": null,
      "max": 100.0,
      "max_std": null,
      "secs": 3,
      "load": 0.0
    }
  ]
}